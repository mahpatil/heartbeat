#!/bin/bash
#
# Heartbeat CLI - natural language cron setup
# Usage: heartbeat <command> [options]
#

HEARTBEAT_DIR="${HOME}/.heartbeat"
HEARTBEAT_PY="${HEARTBEAT_DIR}/heartbeat.py"
HEARTBEAT_JOBS="${HEARTBEAT_DIR}/jobs"
HEARTBEAT_LOGS="${HEARTBEAT_DIR}/logs"
CRON_TAG="# HEARTBEAT"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log_info() { echo -e "${GREEN}[+]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[!]${NC} $1"; }
log_error() { echo -e "${RED}[-]${NC} $1"; }

usage() {
    cat <<EOF
Heartbeat - scheduled task runner

Usage: heartbeat <command> [options]

Commands:
    add <name> [options]     Add a new heartbeat job
    list                     List all heartbeat jobs
    remove <name>           Remove a heartbeat job
    run <name>               Run a heartbeat job manually
    logs [name]              Show logs (last 50 lines)
    help                     Show this help

Options for add:
    --folder <path>          Folder to watch (default: current dir)
    --frequency <freq>      Frequency (e.g., "15min", "hourly", "daily at 9:00")
    --task <task>           Task to run (can specify multiple)
    --config <file>         Use existing config file as template

Examples:
    heartbeat add "check site" --folder ~/project --frequency "every 15 min"
    heartbeat add "morning report" --frequency "daily at 9:00"
    heartbeat add "hourly check" --frequency "hourly"
    heartbeat list
    heartbeat run "check site"
    heartbeat logs

Frequency shortcuts:
    15min     -> "*/15 * * * *"
    30min     -> "*/30 * * * *"
    hourly    -> "0 * * * *"
    daily     -> "0 * * * *"
    daily 9   -> "0 9 * * *"
    weekly    -> "0 0 * * 0"

EOF
}

check_deps() {
    if [[ ! -f "$HEARTBEAT_PY" ]]; then
        log_error "heartbeat.py not found at $HEARTBEAT_PY"
        exit 1
    fi
    
    if [[ ! -x "$HEARTBEAT_PY" ]]; then
        chmod +x "$HEARTBEAT_PY"
    fi
}

parse_frequency() {
    local freq="$1"
    local cron=""
    
    case "$freq" in
        15min|15min*|*15min)
            cron="*/15 * * * *" ;;
        30min|30min*|*30min)
            cron="*/30 * * * *" ;;
        hourly|hourly|*hourly)
            cron="0 * * * *" ;;
        daily|daily)
            cron="0 * * * *" ;;
        daily\ at\ *|daily\ at\ *)
            local time_part=$(echo "$freq" | sed 's/.*at //')
            local hour=$(echo "$time_part" | cut -d: -f1)
            cron="0 ${hour:-9} * * *" ;;
        weekly|weekly)
            cron="0 0 * * 0" ;;
        *)
            cron="$freq" ;;
    esac
    
    echo "$cron"
}

cmd_add() {
    local name=""
    local folder="."
    local frequency="*/15 * * * *"
    local tasks=()
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --folder|-f)
                folder="$2"
                shift 2 ;;
            --frequency|--freq|-r)
                frequency=$(parse_frequency "$2")
                shift 2 ;;
            --task|-t)
                tasks+=("$2")
                shift 2 ;;
            -*)
                shift ;;
            *)
                if [[ -z "$name" ]]; then
                    name="$1"
                fi
                shift ;;
        esac
    done
    
    if [[ -z "$name" ]]; then
        log_error "Job name required"
        usage
        exit 1
    fi
    
    local job_file="${HEARTBEAT_JOBS}/${name}.yaml"
    
    cat > "$job_file" <<EOF
# Heartbeat: $name
# Created: $(date)
# Frequency: $frequency

name: "$name"
folder: "$folder"
frequency: "$frequency"

tasks: []
EOF

    log_info "Created job: $name"
    log_info "Config: $job_file"
    log_info "Frequency: $frequency"
    log_warn "Edit the config file to add tasks, then run:"
    log_warn "  heartbeat add-cron '$name'"
}

cmd_add_cron() {
    local name="$1"
    
    if [[ -z "$name" ]]; then
        log_error "Job name required"
        exit 1
    fi
    
    local job_file=""
    for ext in ".yaml" ".yml" ".htb"; do
        if [[ -f "${HEARTBEAT_JOBS}/${name}${ext}" ]]; then
            job_file="${HEARTBEAT_JOBS}/${name}${ext}"
            break
        fi
    done
    
    if [[ -z "$job_file" ]]; then
        log_error "Job not found: $name"
        exit 1
    fi
    
    local frequency=$(grep -E "^frequency:" "$job_file" 2>/dev/null | sed 's/.*frequency: *//' | tr -d '"') || echo "*/15 * * * *"
    local cron_cmd="python3 ${HEARTBEAT_PY} -c '${job_file}'"
    local cron_entry="${frequency} ${cron_cmd}  ${CRON_TAG} ${name}"
    
    (crontab -l 2>/dev/null | grep -v "${CRON_TAG} ${name}$"; echo "$cron_entry") | crontab -
    
    log_info "Added cron job: $name"
    log_info "To edit crontab: crontab -e"
}

cmd_list() {
    echo "Heartbeat Jobs:"
    echo "=============="
    
    if [[ ! -d "$HEARTBEAT_JOBS" ]]; then
        log_warn "No jobs directory"
        return
    fi
    
    local count=0
    for job in "${HEARTBEAT_JOBS}"/*; do
        [[ -f "$job" ]] || continue
        ((count++))
        local name=$(basename "$job")
        local freq=$(grep -E "frequency:" "$job" 2>/dev/null | head -1 | cut -d: -f2- | tr -d '"' || echo "unknown")
        echo "  $name -> $freq"
    done
    
    if [[ $count -eq 0 ]]; then
        echo "  No jobs found"
    fi
    
    echo ""
    echo "Active cron jobs:"
    echo "==============="
    crontab -l 2>/dev/null | grep "$CRON_TAG" || echo "  No cron jobs"
}

cmd_remove() {
    local name="$1"
    
    if [[ -z "$name" ]]; then
        log_error "Job name required"
        exit 1
    fi
    
    local job_file=""
    for ext in ".yaml" ".yml" ".htb"; do
        if [[ -f "${HEARTBEAT_JOBS}/${name}${ext}" ]]; then
            job_file="${HEARTBEAT_JOBS}/${name}${ext}"
            break
        fi
    done
    
    if [[ -n "$job_file" ]]; then
        rm "$job_file"
        log_info "Removed job file: $job_file"
    else
        log_warn "Job file not found: $name"
    fi
    
    crontab -l 2>/dev/null | grep -v "${CRON_TAG} ${name}:" | crontab -
    log_info "Removed cron job: $name"
}

cmd_run() {
    local name="$1"
    
    if [[ -z "$name" ]]; then
        log_error "Job name required"
        exit 1
    fi
    
    local job_file=""
    for ext in ".yaml" ".yml" ".htb"; do
        if [[ -f "${HEARTBEAT_JOBS}/${name}${ext}" ]]; then
            job_file="${HEARTBEAT_JOBS}/${name}${ext}"
            break
        fi
    done
    
    if [[ -z "$job_file" ]]; then
        log_error "Job not found: $name"
        exit 1
    fi
    
    log_info "Running job: $name"
    python3 "$HEARTBEAT_PY" -c "$job_file"
}

cmd_logs() {
    local name="$1"
    local log_file="${HEARTBEAT_LOGS}/heartbeat.log"
    
    if [[ -n "$name" ]]; then
        log_file="${HEARTBEAT_LOGS}/${name}.log"
    fi
    
    if [[ -f "$log_file" ]]; then
        tail -50 "$log_file"
    else
        log_warn "No log file: $log_file"
    fi
}

main() {
    check_deps
    
    local command="${1:-}"
    shift || true
    
    case "$command" in
        add)
            cmd_add "$@" ;;
        add-cron)
            cmd_add_cron "$@" ;;
        list|ls)
            cmd_list ;;
        remove|rm|delete)
            cmd_remove "$@" ;;
        run|exec)
            cmd_run "$@" ;;
        logs)
            cmd_logs "$@" ;;
        help|-h|--help|"")
            usage ;;
        *)
            log_error "Unknown command: $command"
            usage
            exit 1 ;;
    esac
}

main "$@"